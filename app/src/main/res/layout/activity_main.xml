<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Пользовательский фон: неподвижная картинка + затемнение -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/bgScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />

<LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Заголовок (отступ сверху под статус-бар задаётся в коде) -->
    <LinearLayout
        android:id="@+id/headerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backBtn"
                style="@style/PlayerButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/screenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/countText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/sortBtn"
                style="@style/PlayerButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/sort"
                android:src="@drawable/ic_sort"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/bgBtn"
                style="@style/PlayerButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="-10dp"
                android:contentDescription="@string/background"
                android:src="@drawable/ic_image" />
        </LinearLayout>


        <!-- Кнопки действий: меняются в зависимости от экрана -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/playAllBtn"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/play"
                app:icon="@drawable/ic_play"
                app:iconSize="20dp" />

            <Button
                android:id="@+id/shuffleAllBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/shuffle"
                app:icon="@drawable/ic_shuffle"
                app:iconSize="20dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Список / пустое состояние -->
    <FrameLayout
        android:id="@+id/listContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trackList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <Button
                android:id="@+id/grantButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/grant" />
        </LinearLayout>
    </FrameLayout>

    <!-- Мини-плеер -->
    <LinearLayout
        android:id="@+id/playerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/nowArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/posText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/durText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/shuffleBtn"
                style="@style/PlayerButton"
                android:contentDescription="@string/shuffle"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/prevBtn"
                style="@style/PlayerButton"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/playBtn"
                style="@style/PlayerButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/nextBtn"
                style="@style/PlayerButton"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_next" />

            <ImageButton
                android:id="@+id/repeatBtn"
                style="@style/PlayerButton"
                android:contentDescription="@string/repeat"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>
    </LinearLayout>
    <!-- Нижнее меню: треки / плейлисты -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/panel"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navTracks"
            style="@style/NavItem">

            <FrameLayout style="@style/NavIconBox">

                <View
                    android:id="@+id/navTracksPill"
                    style="@style/NavPill" />

                <ImageView
                    android:id="@+id/navTracksIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_music" />
            </FrameLayout>

            <TextView
                android:id="@+id/navTracksLabel"
                style="@style/NavLabel"
                android:text="@string/tab_tracks" />
        </LinearLayout>

        <!-- Слот под кнопку «+»: ширина анимируется от 0, раздвигая пункты меню -->
        <FrameLayout
            android:id="@+id/addSlot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/addPlaylistBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/add_btn_bg"
                android:contentDescription="@string/new_playlist"
                android:elevation="2dp"
                android:scaleType="center"
                android:src="@drawable/ic_add"
                app:tint="@color/on_accent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navPlaylists"
            style="@style/NavItem">

            <FrameLayout style="@style/NavIconBox">

                <View
                    android:id="@+id/navPlaylistsPill"
                    style="@style/NavPill" />

                <ImageView
                    android:id="@+id/navPlaylistsIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_playlist" />
            </FrameLayout>

            <TextView
                android:id="@+id/navPlaylistsLabel"
                style="@style/NavLabel"
                android:text="@string/tab_playlists" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
